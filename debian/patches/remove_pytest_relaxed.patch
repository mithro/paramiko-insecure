diff --git a/setup.cfg b/setup.cfg
index e503126..f319864 100644
--- a/setup.cfg
+++ b/setup.cfg
@@ -13,7 +13,6 @@ ignore = E124,E125,E128,E261,E301,E302,E303,E402,E721,W503,E203,E722
